{
  "name": "sisqueslabs/nestjs-template",
  "version": "0.2.4",
  "description": "Sisques Labs NestJS service template — DDD+CQRS+Hexagonal, TypeORM/Postgres, Kafka, GraphQL+REST, OpenTelemetry, MCP.",
  "author": "Sisques Labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/sisques-labs/nestjs-template.git"
  },
  "homepage": "https://github.com/sisques-labs/nestjs-template",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.21.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11",
      "onFail": "ignore"
    }
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "gen:topics": "ts-node --transpile-only --project tsconfig.scripts.json scripts/generate-aggregate-module-map.ts",
    "gen:topics:check": "ts-node --transpile-only --project tsconfig.scripts.json scripts/generate-aggregate-module-map.ts --check",
    "test": "jest",
    "test:changed": "jest --onlyChanged",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:api": "pnpm test:e2e",
    "pretest:e2e": "node scripts/check-db.js",
    "test:integration": "jest --config ./test/jest-integration.json",
    "pretest:integration": "node scripts/check-db.js",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "typeorm": "ts-node --project tsconfig.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "pnpm typeorm migration:generate -d src/database/data-source.ts",
    "migration:create": "pnpm typeorm migration:create",
    "migration:run": "pnpm typeorm migration:run -d src/database/data-source.ts",
    "migration:revert": "pnpm typeorm migration:revert -d src/database/data-source.ts",
    "migration:show": "pnpm typeorm migration:show -d src/database/data-source.ts",
    "prepare": "node -e \"if(process.env.HUSKY!=='0')require('child_process').execSync('husky',{stdio:'inherit'})\""
  },
  "dependencies": {
    "@apollo/server": "^4.13.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@nestjs/apollo": "12.2.2",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/graphql": "13.4.2",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/typeorm": "11.0.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.221.0",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.221.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-logs": "0.221.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@opentelemetry/winston-transport": "^0.31.0",
    "@sisques-labs/nestjs-kit": "^1.3.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "graphql": "^17.0.0",
    "graphql-query-complexity": "^2.0.0",
    "graphql-type-json": "^0.3.2",
    "kafkajs": "^2.2.4",
    "nest-winston": "^1.10.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@testcontainers/postgresql": "12.0.4",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.1.0",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!main.ts",
      "!telemetry.ts",
      "!**/*.module.ts",
      "!database/data-source.ts",
      "!**/*.interface.ts",
      "!**/*.primitives.ts",
      "!**/*.entity.ts",
      "!**/*.dto.ts",
      "!**/*.input.ts",
      "!**/*.object.ts",
      "!**/*.view-model.ts",
      "!**/*.enum.ts",
      "!**/*.generated.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@core/(.*)$": "<rootDir>/core/$1",
      "^@contexts/(.*)$": "<rootDir>/contexts/$1",
      "^@support/(.*)$": "<rootDir>/support/$1",
      "^@scripts/(.*)$": "<rootDir>/../scripts/$1"
    }
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
