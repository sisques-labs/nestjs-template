PORT=3000
NODE_ENV=development

# Frontend base URL (used for CORS in dev; ignored when CORS_ORIGINS is set)
FRONTEND_URL=http://localhost:3001

# Allowed browser origins for credentialed CORS (comma-separated).
# Falls back to FRONTEND_URL when unset. Required in production.
# CORS_ORIGINS=http://localhost:3001,https://app.example.com

# PostgreSQL — individual connection vars (DATABASE_URL is NOT supported)
DATABASE_DRIVER=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=secret
DATABASE_DATABASE=nestjs_template_db
# Run pending migrations automatically on boot (default: true)
# DATABASE_MIGRATIONS_RUN=true
# Never set to true in production — dev/test convenience only
# DATABASE_SYNCHRONIZE=false

# OpenTelemetry — traces, metrics, and logs (optional, all disabled together
# when OTEL_EXPORTER_OTLP_ENDPOINT is unset). Logs still go to console/file
# either way; when set, they're also forwarded via OTLP alongside
# traces/metrics — see docker/otel-collector-config.yaml to point them at a
# real backend (Loki, etc.), the app side doesn't change.
# `docker compose up -d` also starts a local otel-collector + Jaeger +
# Prometheus (see docker-compose.yml) — point this at it to see traces/metrics
# in dev: Jaeger UI on :16686, Prometheus UI on :9090.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=nestjs-template
OTEL_TRACES_SAMPLE_RATIO=1.0
OTEL_METRIC_EXPORT_INTERVAL_MILLIS=15000

# Kafka — domain event forwarding (opt-in; app boots without a broker when disabled)
KAFKA_ENABLED=false
# Comma-separated broker list — required when KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=nestjs-template
# Topics are ${KAFKA_TOPIC_PREFIX}.${module}, e.g. nestjs-template.plants
KAFKA_TOPIC_PREFIX=nestjs-template
KAFKA_SSL=false
# SASL is optional — set username + password to enable
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Logging
LOG_LEVEL=info

# Identity bridge (src/core/identity/) — opt-in, no auth is enforced unless
# IDENTITY_PROVIDER is set. Only the block matching the chosen provider is
# required; the other two blocks are ignored.
# IDENTITY_PROVIDER=cognito

# Required when IDENTITY_PROVIDER=cognito
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_REGION=
# Hosted UI domain (no scheme), used for the OAuth authorize/token endpoints
# COGNITO_HOSTED_UI_DOMAIN=my-app.auth.us-east-1.amazoncognito.com

# Required when IDENTITY_PROVIDER=supabase
# SUPABASE_URL=
# SUPABASE_JWT_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=

# Required when IDENTITY_PROVIDER=oidc
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Claim holding roles in the ID/access token (default: "roles")
# OIDC_ROLE_CLAIM=roles

# OAuth/BFF session login (src/core/identity/) — opt-in, cookie-based social
# login (Google etc., via whichever IDENTITY_PROVIDER is active) alongside
# the bearer-token POST /auth/login above. Requires IDENTITY_PROVIDER to be
# set and a Redis instance (see the redis service in docker-compose.yml).
# OAUTH_SESSION_ENABLED=true

# Required when OAUTH_SESSION_ENABLED=true
# SESSION_REDIS_URL=redis://localhost:6379
# OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/callback
# OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3001/dashboard

# Optional — defaults shown
# SESSION_COOKIE_NAME=session
# SESSION_TTL_SECONDS=86400
